<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Upgrade">
            <directory>tests/Upgrade</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="256M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:TbUv6PHz9lQvqarM+MdbCNUwlFEivZz/xxYNv1ICjh8="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!-- Laravel reads $_SERVER before $_ENV, and PHPUnit only sets $_SERVER from <server>. -->
        <env name="DB_TELEMETRY_DATABASE" value="" force="true"/>
        <env name="DB_TELEMETRY_URL" value="" force="true"/>
        <env name="DB_TELEMETRY_HOST" value="" force="true"/>
        <env name="DB_TELEMETRY_PORT" value="" force="true"/>
        <env name="DB_TELEMETRY_USERNAME" value="" force="true"/>
        <env name="DB_TELEMETRY_PASSWORD" value="" force="true"/>
        <env name="DB_LOGS_DATABASE" value="" force="true"/>
        <env name="DB_LOGS_URL" value="" force="true"/>
        <env name="DB_LOGS_HOST" value="" force="true"/>
        <env name="DB_LOGS_PORT" value="" force="true"/>
        <env name="DB_LOGS_USERNAME" value="" force="true"/>
        <env name="DB_LOGS_PASSWORD" value="" force="true"/>
        <server name="DB_TELEMETRY_DATABASE" value="" force="true"/>
        <server name="DB_TELEMETRY_URL" value="" force="true"/>
        <server name="DB_TELEMETRY_HOST" value="" force="true"/>
        <server name="DB_TELEMETRY_PORT" value="" force="true"/>
        <server name="DB_TELEMETRY_USERNAME" value="" force="true"/>
        <server name="DB_TELEMETRY_PASSWORD" value="" force="true"/>
        <server name="DB_LOGS_DATABASE" value="" force="true"/>
        <server name="DB_LOGS_URL" value="" force="true"/>
        <server name="DB_LOGS_HOST" value="" force="true"/>
        <server name="DB_LOGS_PORT" value="" force="true"/>
        <server name="DB_LOGS_USERNAME" value="" force="true"/>
        <server name="DB_LOGS_PASSWORD" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="TRUSTED_PROXIES" value="(null)"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
