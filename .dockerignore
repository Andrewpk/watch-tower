# Keep the build context small and the image free of local state.
# Anything the image needs at runtime is copied explicitly in the Dockerfile.

# VCS, CI and tooling. .claude holds agent worktrees with full copies of
# vendor/ and node_modules/, so it must never reach the build context.
.git
.gitattributes
.github
.claude
.mcp.json
boost.json
opencode.json
AGENTS.md
CLAUDE.md

# Dependencies and build output are produced inside the image.
vendor
node_modules
public/build
public/hot
public/storage
public/fonts-manifest.dev.json
bootstrap/ssr

# Wayfinder output is regenerated by `npm run build`.
resources/js/routes
resources/js/actions
resources/js/wayfinder

# Secrets and local environment. Never bake these into an image.
.env*
!.env.example
auth.json

# Local databases.
database/*.sqlite*

# Runtime state. The .gitignore placeholders are kept so the directories exist.
bootstrap/cache/*
!bootstrap/cache/.gitignore
storage/*.key
storage/pail
storage/logs/*
!storage/logs/.gitignore
storage/debugbar/*
!storage/debugbar/.gitignore
storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore

# Tests, docs and dev-only config.
tests
doc
*.md
phpunit.xml
.phpunit.cache
.phpunit.result.cache
pint.json
eslint.config.js
.prettierrc
.prettierignore
.editorconfig
pnpm-workspace.yaml

# Docker files themselves.
Dockerfile*
.dockerignore
docker-compose*
compose.y*ml

# Editors, OS and logs.
.idea
.vscode
.fleet
.nova
.zed
.phpactor.json
.DS_Store
Thumbs.db
*.log
npm-debug.log
yarn-error.log
